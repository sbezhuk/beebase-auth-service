# Copy to .env for local development: cp .env.example .env

# development | production
APP_ENV=development

# debug | info | warn | error
LOG_LEVEL=debug

HTTP_PORT=8081
HTTP_READ_TIMEOUT=5s
HTTP_WRITE_TIMEOUT=10s
HTTP_IDLE_TIMEOUT=60s
HTTP_SHUTDOWN_TIMEOUT=15s

# Used by the app.
DATABASE_URL=postgres://beebase:beebase@localhost:5432/beebase?sslmode=disable
DATABASE_CONNECT_TIMEOUT=5s

# Used by docker-compose to provision the postgres container.
POSTGRES_USER=beebase
POSTGRES_PASSWORD=beebase
POSTGRES_DB=beebase

# Required: base64-encoded Ed25519 private key (64 bytes). This is the
# only key that can mint access tokens for the whole BeeBase deployment;
# every other service verifies against the matching public key served at
# this service's /.well-known/jwks.json. Generate one with: make keygen
# Never commit a real key; this placeholder is for local dev only.
JWT_PRIVATE_KEY=LPpsYvmwo/lHrmJbibpmGGkR4/UVlUlrF8phqJjxsBV7XVOBz5hk6CzKDGcNKdeERJq2D3kkxaizieWI1rIb6Q==

ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=720h

# The refresh token is set as an HttpOnly cookie, never returned in a
# response body. COOKIE_DOMAIN scopes it; leave empty for host-only
# (fine for local dev), or set it to a shared parent domain (e.g.
# ".beebase.app") if the frontend lives on a different subdomain than
# the gateway. COOKIE_SECURE defaults to true unless APP_ENV=development,
# so local HTTP dev keeps working without setting it explicitly.
COOKIE_DOMAIN=
COOKIE_SECURE=

# Used only by `make test-integration`, never by the app itself. Point it
# at a disposable database (docker-compose's postgres, a second DB on it,
# or a separate container) — integration tests execute real writes.
TEST_DATABASE_URL=postgres://beebase:beebase@localhost:5432/beebase_test?sslmode=disable
