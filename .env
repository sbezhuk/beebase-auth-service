# Copy to .env for local development: cp .env.example .env

# development | production
APP_ENV=production

# debug | info | warn | error
LOG_LEVEL=warn

HTTP_PORT=8081
HTTP_READ_TIMEOUT=5s
HTTP_WRITE_TIMEOUT=10s
HTTP_IDLE_TIMEOUT=60s
HTTP_SHUTDOWN_TIMEOUT=15s

# Used by docker-compose to provision the postgres container, and to
# build DATABASE_URL below (kept in sync automatically - only ever
# change the password here, not in DATABASE_URL itself).
POSTGRES_USER=beebase
POSTGRES_PASSWORD=KXrnZ9WRWgYG2jTgbNVR8or6p4dMQ1
POSTGRES_DB=beebase_auth
# Overridden by beebase-gateway/docker-compose.yml to auth-postgres/5432
# when this service is run as part of the full local stack from there.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Used by the app. Built from the POSTGRES_* values above so the
# password never needs to be duplicated/retyped here.
DATABASE_URL=postgres://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}?sslmode=disable
DATABASE_CONNECT_TIMEOUT=5s

# Required: base64-encoded Ed25519 private key (64 bytes). This is the
# only key that can mint access tokens for the whole BeeBase deployment;
# every other service verifies against the matching public key served at
# this service's /.well-known/jwks.json. Generate one with: make keygen
# Never commit a real key; this placeholder is for local dev only.
JWT_PRIVATE_KEY=tSh90Mcd0CYajtHW5JY0J2LDuDhvKpBL2jxotNJkUAtA1Rm9rx4LbH7+4UpHv+sTrylrWV6WsZdfAQO95hUwnQ==

ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=720h

# The refresh token is set as an HttpOnly cookie, never returned in a
# response body. COOKIE_DOMAIN scopes it; leave empty for host-only
# (fine for local dev), or set it to a shared parent domain (e.g.
# ".beebase.app") if the frontend lives on a different subdomain than
# the gateway. COOKIE_SECURE defaults to true unless APP_ENV=development,
# so local HTTP dev keeps working without setting it explicitly.
COOKIE_DOMAIN=
COOKIE_SECURE=

# media-service's base URL. Updating a profile's avatar asks it, once, to
# verify the caller actually owns the referenced media id.
MEDIA_SERVICE_URL=http://localhost:8085

# Required: base64-encoded 32-byte AES-256 key used to encrypt TOTP (2FA)
# secrets at rest. Generate one with: openssl rand -base64 32
TOTP_ENCRYPTION_KEY=XkNaG+sLF8RDEZkinLUFfQD8vCa7dng2Xwvyz90EqXI=

# Label shown in a user's authenticator app alongside their account name.
TOTP_ISSUER=BeeBase

# 2FA / password-recovery security tuning. All optional; defaults shown.
TOTP_SETUP_TOKEN_TTL=15m
LOGIN_CHALLENGE_TTL=5m
PASSWORD_RESET_FLOW_TTL=10m
PASSWORD_RESET_TOKEN_TTL=10m
TOTP_MAX_FAILED_ATTEMPTS=5
TOTP_LOCKOUT_DURATION=15m
PASSWORD_RESET_FLOW_MAX_OTP_ATTEMPTS=5

# Used only by `make test-integration`, never by the app itself. Point it
# at a disposable database (docker-compose's postgres, a second DB on it,
# or a separate container) — integration tests execute real writes.
TEST_DATABASE_URL=postgres://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/beebase_test?sslmode=disable
